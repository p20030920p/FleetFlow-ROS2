<?xml version="1.0"?>
<!-- FleetFlow-ROS2 AGV: 差速底盘 + 360° LiDAR，robot_id 决定命名空间与配色 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="agv">

  <xacro:arg name="robot_id" default="0"/>
  <xacro:arg name="body_color" default="0.16 0.45 0.78"/>

  <xacro:property name="robot_id"   value="$(arg robot_id)"/>
  <xacro:property name="body_color" value="$(arg body_color)"/>

  <!-- 尺寸：**直径 0.50 m 的圆盘差速底盘**（layout.AGV 是同一份规格）。
       工业 AGV 多用圆车：任意朝向占地相同，避让判据不必分朝向。
       参数取公开规格的量级（松灵/宇树这类底盘：直径 0.4~0.6 m、
       高 0.25~0.35 m、轮距约 0.36 m、带 360° 雷达）。 -->
  <xacro:property name="body_r"   value="0.25"/>   <!-- 半径 = 直径 0.50 -->
  <xacro:property name="body_h"   value="0.24"/>
  <xacro:property name="wheel_r"  value="0.06"/>
  <xacro:property name="wheel_w"  value="0.04"/>
  <xacro:property name="sep"      value="0.36"/>   <!-- 轮距（左右轮中心距） -->
  <xacro:property name="deck_z"   value="${body_h/2 + 0.012}"/>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_r}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual name="body">
      <geometry><cylinder radius="${body_r}" length="${body_h}"/></geometry>
      <material name="body"><color rgba="${body_color} 1"/></material>
    </visual>
    <!-- 顶面浅色甲板（圆），俯视时能一眼分清车体 -->
    <visual name="deck">
      <origin xyz="0 0 ${deck_z}" rpy="0 0 0"/>
      <geometry><cylinder radius="${body_r*0.78}" length="0.012"/></geometry>
      <material name="deck"><color rgba="0.96 0.97 0.98 1"/></material>
    </visual>
    <!-- 车头指向标记：俯视时的朝向全靠它 -->
    <visual name="nose">
      <origin xyz="${body_r*0.72} 0 ${body_h/2 - 0.005}" rpy="0 0 0"/>
      <geometry><box size="0.10 0.06 0.02"/></geometry>
      <material name="nose"><color rgba="1.0 0.45 0.10 1"/></material>
    </visual>
    <!-- 360° 雷达（顶部圆柱），与 LiDAR 安装高度一致 -->
    <visual name="lidar">
      <origin xyz="${body_r*0.55} 0 ${body_h/2 + 0.03}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.05"/></geometry>
      <material name="lidar"><color rgba="0.12 0.12 0.14 1"/></material>
    </visual>
    <collision name="body_c">
      <geometry><cylinder radius="${body_r}" length="${body_h}"/></geometry>
    </collision>
    <inertial>
      <mass value="12.0"/>
      <inertia ixx="0.20" ixy="0" ixz="0" iyy="0.30" iyz="0" izz="0.44"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="side sign">
    <link name="${side}_wheel">
      <visual name="v">
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
        <material name="tyre"><color rgba="0.12 0.13 0.15 1"/></material>
      </visual>
      <collision name="c">
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
      </collision>
      <inertial><mass value="0.6"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/></inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel"/>
      <origin xyz="0 ${sign*sep/2} ${-body_h/2}" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <!-- 轮辐，旋转时能看出车在动 -->
    <link name="${side}_hub">
      <visual name="v">
        <geometry><box size="${wheel_r*1.4} 0.006 ${wheel_r*0.14}"/></geometry>
        <material name="hub"><color rgba="0.90 0.92 0.95 1"/></material>
      </visual>
    </link>
    <joint name="${side}_hub_joint" type="fixed">
      <parent link="${side}_wheel"/>
      <child link="${side}_hub"/>
      <origin xyz="0 ${sign*wheel_w/2} 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel side="left"  sign="1"/>
  <xacro:wheel side="right" sign="-1"/>

  <link name="caster">
    <visual name="v"><geometry><sphere radius="0.045"/></geometry>
      <material name="caster"><color rgba="0.35 0.37 0.40 1"/></material></visual>
    <collision name="c"><geometry><sphere radius="0.045"/></geometry></collision>
    <inertial><mass value="0.2"/><inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004"/></inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="${-body_r*0.72} 0 ${-body_h/2 - 0.03}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual name="v"><geometry><cylinder radius="0.045" length="0.05"/></geometry>
      <material name="lidar"><color rgba="0.10 0.11 0.13 1"/></material></visual>
    <inertial><mass value="0.15"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${body_h/2 + 0.045}" rpy="0 0 0"/>
  </joint>

  <!-- ============ Gazebo Sim 系统 ============ -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${sep}</wheel_separation>
      <wheel_radius>${wheel_r}</wheel_radius>
      <max_linear_acceleration>1.2</max_linear_acceleration>
      <min_linear_acceleration>-2.5</min_linear_acceleration>
      <max_angular_acceleration>2.5</max_angular_acceleration>
      <max_wheel_torque>20.0</max_wheel_torque>
      <max_wheel_acceleration>8.0</max_wheel_acceleration>
      <!-- 话题必须按机器人加命名空间，否则多台车会共用 /odom /cmd_vel 互相串指令 -->
      <odom_topic>/robot_$(arg robot_id)/odom</odom_topic>
      <tf_topic>/robot_$(arg robot_id)/tf</tf_topic>
      <topic>/robot_$(arg robot_id)/cmd_vel</topic>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/robot_$(arg robot_id)/joint_states</topic>
    </plugin>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/robot_$(arg robot_id)/scan</topic>
      <update_rate>8.0</update_rate>
      <always_on>1</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range><min>0.12</min><max>12.0</max><resolution>0.01</resolution></range>
        <!-- 量程 12 m 与 layout.AGV['lidar_range'] 一致：主通道 9.2 m 内可全见 -->
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="base_link"><material>Gazebo/FlatBlack</material></gazebo>
  <gazebo reference="left_wheel"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="right_wheel"><material>Gazebo/Black</material></gazebo>
  <!-- 摩擦系数在这里**写不进去**，留个记录免得再试一遍：
       sdformat 的 URDF 解析器会把摩擦信息整段丢掉 —— 无论是
       <gazebo reference="link"><mu1>/<mu2>，还是 <collision> 里的
       <surface><friction>，转换后都**不出现**在 SDF 里，而且不报错。
       验证方法：gz sdf -p 转一个最小 URDF，输出里既没有 <surface>
       也没有 <mu>。所以轮子只能拿 SDF 默认摩擦（1.0）。
       这也说明"轮子打滑"不是厂房里那台车不走的根因 —— 作为对照，
       把同一台车放进只有一块平地的最小世界，用 gz 原生话题发 0.6 m/s，
       7 秒实走 3.57 m（≈0.6 m/s），轮速恰好 8.000 rad/s，完全正常。
       真正的排查结论见 tools/ 与 README 的"排查记录"。 -->
  <!-- 万向轮是被动支撑，摩擦要低，否则会拖着车不让走 -->
  <gazebo reference="caster">
    <mu1>0.05</mu1><mu2>0.05</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>
  <!-- 车体不许蹭地 -->
  <gazebo reference="base_link">
    <mu1>0.02</mu1><mu2>0.02</mu2>
  </gazebo>
</robot>
